<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Living blue gradient, similar to the streak card -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0A1E3D"
                android:centerColor="#103A76"
                android:endColor="#0A5FD0"
                android:angle="315"
                android:type="linear" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Top-edge glass highlight -->
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="40dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#33FFFFFF"
                android:centerColor="#0AFFFFFF"
                android:endColor="#00000000"
                android:angle="270" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#33FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
